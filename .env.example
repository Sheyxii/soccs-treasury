# Copy to .env once (scripts/setup_xampp.py does this for you and fills in the secrets).
# Generate a secret with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Database (XAMPP MySQL/MariaDB) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=soccs_treasury_dev
MYSQL_USER=soccs_app
MYSQL_PASSWORD=
# Or give a full SQLAlchemy URL instead (overrides the MYSQL_* values), e.g. a hosted MySQL server:
# DATABASE_URL=mysql+pymysql://user:password@db.example.org:3306/soccs_treasury?charset=utf8mb4

# --- Web server (run.py) ---
# 127.0.0.1 = this computer only. Use 0.0.0.0 only behind a firewall or reverse proxy.
HOST=127.0.0.1
PORT=5000
THREADS=8

# --- Going online (leave as-is for the office PC) ---
# Set to true once the site is served over HTTPS.
SESSION_COOKIE_SECURE=false
# Number of reverse proxies (e.g. Nginx, Caddy, IIS) in front of the app; 0 = none.
TRUST_PROXY=0

# --- Security and housekeeping ---
SESSION_TIMEOUT_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOG_LEVEL=INFO
